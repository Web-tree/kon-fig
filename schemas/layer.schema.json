{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kon-Fig layer",
  "type": "object",
  "required": [
    "formatVersion",
    "componentId",
    "schemaVersion",
    "values"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "componentId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
      "maxLength": 253
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "values": {
      "type": "object"
    },
    "unset": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/(?:[^~]|~[01])*$"
      },
      "uniqueItems": true
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "provider",
              "parameters"
            ],
            "additionalProperties": false,
            "properties": {
              "provider": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.-]*$"
              },
              "parameters": {
                "type": "object"
              }
            }
          },
          {
            "type": "null"
          }
        ]
      }
    }
  }
}
