{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kon-Fig context",
  "type": "object",
  "required": [
    "formatVersion",
    "id"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "parent": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "match": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "operator",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "project",
              "path",
              "remote"
            ]
          },
          "operator": {
            "enum": [
              "exact",
              "prefix"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
